	<globalevent name="Clean" interval="10800000" script="custom/clean.lua"/>
	<!--save-->
	<globalevent name="ServerSaveWarning" interval="30800000" script="custom/save.lua" />
	<!--textEffect-->
	<globalevent name="TextosBaiak" interval="5000" script="custom/textEffect.lua"/>
