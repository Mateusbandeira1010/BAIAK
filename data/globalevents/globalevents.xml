	<globalevent name="Battlefield" interval="60000" script="custom/events/battlefield.lua" />
	<!--Castle48H-->
	<globalevent name="Castle48HOpen" time="21:00:00" script="custom/events/castle48h.lua"/>
	<globalevent name="Castle48HClose" time="22:00:00" script="custom/events/castle48h.lua"/>
